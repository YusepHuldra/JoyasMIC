<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%-- Mensaje de una sola vez (lo dejan los servlets en la sesión) --%>
<c:if test="${not empty sessionScope.flashTexto}">
    <div class="flash flash-${sessionScope.flashTipo}" id="flash-msg" role="alert"><c:out value="${sessionScope.flashTexto}"/></div>
    <c:remove var="flashTexto" scope="session"/>
    <c:remove var="flashTipo" scope="session"/>
</c:if>
