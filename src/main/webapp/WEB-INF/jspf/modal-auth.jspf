<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>

<div class="login-overlay" id="user-auth-overlay">
    <div class="login-box">
        <button type="button" class="login-close" id="close-user-auth-btn">&times;</button>

        <div class="auth-tabs">
            <button type="button" class="auth-tab-btn active" id="tab-user-login-btn" onclick="switchAuthTab('login')">Ingresar</button>
            <button type="button" class="auth-tab-btn" id="tab-user-register-btn" onclick="switchAuthTab('register')">Registrarse</button>
        </div>

        <!-- INICIAR SESIÓN (también sirve para el administrador) -->
        <form id="user-login-form" method="post" action="${ctx}/auth/login">
            <h3>Inicia Sesión</h3>
            <div class="admin-form-group">
                <label>Correo Electrónico</label>
                <input type="email" name="email" placeholder="tuemail@ejemplo.com" required>
            </div>
            <div class="admin-form-group">
                <label>Contraseña</label>
                <input type="password" name="password" placeholder="Ingresa tu contraseña" required>
            </div>
            <button type="submit" class="btn-save-product" style="margin-top:0.5rem;">Entrar a Mi Cuenta</button>
        </form>

        <!-- REGISTRO -->
        <form id="user-register-form" method="post" action="${ctx}/auth/registro" style="display: none;">
            <h3>Crea tu Cuenta</h3>
            <p style="font-size: 0.75rem; color: #64748b; margin-bottom: 1rem; text-align: center;">Mínimo 8 caracteres en contraseña. Sin espacios vacíos.</p>
            <div class="admin-form-group">
                <label>Nombre Completo</label>
                <input type="text" name="nombre" placeholder="Ej. Ana García" required>
            </div>
            <div class="admin-form-group">
                <label>Correo Electrónico</label>
                <input type="email" name="email" placeholder="tuemail@ejemplo.com" required>
            </div>
            <div class="admin-form-group">
                <label>Contraseña (Mín. 8 caracteres)</label>
                <input type="password" name="password" placeholder="Crea una contraseña segura" required minlength="8">
            </div>
            <button type="submit" class="btn-save-product" style="margin-top:0.5rem;">Registrarme</button>
        </form>
    </div>
</div>
