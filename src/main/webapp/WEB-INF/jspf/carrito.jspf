<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<fmt:setLocale value="es_MX"/>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:set var="carrito" value="${sessionScope.carrito}"/>

<div class="cart-overlay" id="cart-overlay"></div>
<div class="cart-sidebar" id="cart-sidebar">
    <div class="cart-header">
        <h2>Tu Pedido</h2>
        <button type="button" class="cart-close" id="close-cart-btn">&times;</button>
    </div>

    <div class="cart-items-container" id="cart-items-container">
        <c:choose>
            <c:when test="${empty carrito or carrito.vacio}">
                <p style="color:#64748b; text-align:center; margin-top:2rem;">El carrito está vacío</p>
            </c:when>
            <c:otherwise>
                <c:forEach var="it" items="${carrito.items}">
                    <div class="cart-item">
                        <div class="cart-item-details">
                            <h4><c:out value="${it.nombre}"/></h4>
                            <p>$<fmt:formatNumber value="${it.precio}" pattern="#,##0.##"/> x ${it.cantidad}</p>
                        </div>
                        <div class="cart-item-actions">
                            <form class="inline-form" method="post" action="${ctx}/carrito/cambiar">
                                <input type="hidden" name="id" value="${it.productoId}">
                                <input type="hidden" name="delta" value="-1">
                                <input type="hidden" name="categoria" value="${categoriaActual}">
                                <button type="submit" class="btn-qty">-</button>
                            </form>
                            <span>${it.cantidad}</span>
                            <form class="inline-form" method="post" action="${ctx}/carrito/cambiar">
                                <input type="hidden" name="id" value="${it.productoId}">
                                <input type="hidden" name="delta" value="1">
                                <input type="hidden" name="categoria" value="${categoriaActual}">
                                <button type="submit" class="btn-qty">+</button>
                            </form>
                        </div>
                    </div>
                </c:forEach>
            </c:otherwise>
        </c:choose>
    </div>

    <div class="cart-total-box">
        <span>Total:</span>
        <span id="cart-total-value">$<fmt:formatNumber value="${empty carrito ? 0 : carrito.total}" pattern="#,##0.##"/></span>
    </div>

    <c:if test="${not empty carrito and not carrito.vacio}">
        <form method="get" action="${ctx}/carrito/whatsapp" target="_blank">
            <button type="submit" class="btn-whatsapp-send">Pedir por WhatsApp</button>
        </form>
    </c:if>
</div>
