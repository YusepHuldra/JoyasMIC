<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:set var="usuario" value="${sessionScope.usuario}"/>
<c:set var="carrito" value="${sessionScope.carrito}"/>

<div class="top-bar">
    <div class="user-nav-status" id="user-nav-status">
        <c:choose>
            <c:when test="${not empty usuario}">
                <span>👤 Hola, <c:out value="${usuario.nombre}"/></span>
                <c:if test="${usuario.admin}">
                    <a class="btn-user-action" href="${ctx}/admin">Panel Admin</a>
                </c:if>
                <form class="inline-form" method="post" action="${ctx}/auth/logout">
                    <button type="submit" class="btn-user-action btn-logout-user">Cerrar Sesión</button>
                </form>
            </c:when>
            <c:otherwise>
                <span>👋 Bienvenido/a</span>
                <button type="button" class="btn-user-action" onclick="openCustomerAuthModal('login')">Iniciar Sesión / Registrarse</button>
            </c:otherwise>
        </c:choose>
    </div>
    <div class="top-bar-links">
        <a href="https://www.facebook.com/profile.php?id=61586415724068&locale=es_LA" target="_blank" rel="noopener">Facebook</a>
        <a href="https://www.instagram.com/joyasmic/" target="_blank" rel="noopener">Instagram</a>
    </div>
</div>

<header>
    <div class="nav-container">
        <div class="logo">JOYAS<span>MIC</span></div>
        <div class="nav-actions">
            <ul class="nav-menu">
                <li><a href="#inicio">Inicio</a></li>
                <li><a href="#catalogo">Colección</a></li>
                <li><a href="#contacto">Contacto</a></li>
            </ul>
            <button type="button" class="cart-icon-btn" id="open-cart-btn">
                🛒 Carrito <span class="cart-count" id="cart-count-badge">${empty carrito ? 0 : carrito.cantidadTotal}</span>
            </button>
        </div>
    </div>
</header>
